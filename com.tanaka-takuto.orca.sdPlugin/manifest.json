{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "Orca",
  "Version": "0.8.0.0",
  "Author": "tanaka-takuto",
  "Description": "Orca のワークスペース状態の表示・切り替え、シェルコマンドの実行、AIへの指示送信を行います。",
  "UUID": "com.tanaka-takuto.orca",
  "Category": "Orca",
  "CategoryIcon": "imgs/category-icon",
  "Icon": "imgs/plugin-icon",
  "CodePath": "bin/plugin.cjs",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.9"
  },
  "Nodejs": {
    "Version": "20"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Actions": [
    {
      "Name": "レビュー依頼からAI起動",
      "UUID": "com.tanaka-takuto.orca.pr-review",
      "Icon": "imgs/action-icon",
      "Tooltip": "自分・所属チームへのレビュー依頼PRを選び、対象ワークスペースで新しいAIを起動します。入力テキスト・Enterは設定できます。",
      "PropertyInspectorPath": "ui/pr-review.html",
      "Controllers": ["Encoder"],
      "Encoder": {
        "layout": "ui/pr-review.json",
        "TriggerDescription": {
          "Rotate": "レビュー依頼されたPRを選ぶ",
          "Push": "ワークスペースを用意してAIを起動・入力する",
          "Touch": "GitHubのレビュー依頼を更新する"
        }
      },
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "確認先を開く",
      "UUID": "com.tanaka-takuto.orca.attention",
      "Icon": "imgs/action-icon",
      "Tooltip": "入力待ち・返答候補を自動取得。表示した作業場所を開き、次の候補へ進みます。既読や承認にはしません。",
      "PropertyInspectorPath": "ui/attention.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "表示AIへ入力",
      "UUID": "com.tanaka-takuto.orca.active-ai-input",
      "Icon": "imgs/action-icon",
      "Tooltip": "キーに表示されたワークスペースのAIへ文字列を入力します。Enterは任意。",
      "PropertyInspectorPath": "ui/active-ai-input.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "コマンド・AI指示",
      "UUID": "com.tanaka-takuto.orca.workspace-command",
      "Icon": "imgs/action-icon",
      "Tooltip": "選択したワークスペースでコマンドを実行、または指定した AI へ指示を送ります。",
      "PropertyInspectorPath": "ui/workspace-command.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "ワークスペースの状態",
      "UUID": "com.tanaka-takuto.orca.workspace-status",
      "Icon": "imgs/action-icon",
      "Tooltip": "短押しで割当WSへ移動（500ms待ち）。ダブルで関連Issue/PR、700ms長押しでOrcaの選択WSをこのボタンに登録。",
      "PropertyInspectorPath": "ui/workspace-status.html",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "ワークスペース切り替え",
      "UUID": "com.tanaka-takuto.orca.workspace-dial",
      "Icon": "imgs/action-icon",
      "Tooltip": "回転で全候補を選び、押し込みで次の入力待ちへ切り替えます。同じ操作 ID のコマンドキー・レーダーに反映します。状態ボタンは独立です。",
      "PropertyInspectorPath": "ui/workspace-dial.html",
      "Controllers": ["Encoder"],
      "Encoder": {
        "layout": "ui/workspace-dial.json",
        "TriggerDescription": {
          "Rotate": "コマンドキー・レーダーの対象WSを選ぶ",
          "Push": "次の入力待ちワークスペースを選ぶ"
        }
      },
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    },
    {
      "Name": "並列変更レーダー",
      "UUID": "com.tanaka-takuto.orca.change-radar",
      "Icon": "imgs/action-icon",
      "Tooltip": "別ワークスペースと共通する変更箇所を探し、双方のコードへ移動します。",
      "PropertyInspectorPath": "ui/change-radar.html",
      "Controllers": ["Encoder"],
      "Encoder": {
        "layout": "ui/change-radar.json",
        "TriggerDescription": {
          "Rotate": "接点を選ぶ",
          "Push": "自分側のコードを開く",
          "Touch": "相手側のコードを開く"
        }
      },
      "States": [
        {
          "Image": "imgs/key",
          "ShowTitle": false
        }
      ]
    }
  ]
}
